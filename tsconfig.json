{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "jest"],
    "rootDir": ".",
    "outDir": "./dist",
    "noEmitOnError": true
  },
  "include": ["src", "test"],
  "exclude": ["node_modules", "dist"]
}
